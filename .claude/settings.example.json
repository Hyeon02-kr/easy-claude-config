{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(~/.claude.json)",
      "Read(~/.claude/mcp-secrets.json)",
      "Bash(*.claude.json*)",
      "Bash(*mcp-secrets.json*)",
      "PowerShell(*.claude.json*)",
      "PowerShell(*mcp-secrets.json*)",
      "Bash(claude mcp get*)",
      "Bash(claude mcp list*)",
      "PowerShell(claude mcp get*)",
      "PowerShell(claude mcp list*)"
    ],
    "ask": [
      "Bash(*Co-Authored-By*)"
    ],
    "defaultMode": "auto"
  },
  "model": "Sonnet",
  "worktree": {
    "baseRef": "fresh"
  },
  "enableArtifact": false,
  "enableWorkflows": true,
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "language": "한국어",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "normal",
  "verbose": true,
  "preferredNotifChannel": "notifications_disabled",
  "autoCompactEnabled": false,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(git commit:*) in this repo — repo convention requires explicit per-action user approval before committing (CLAUDE.md B4)",
      "Bash(git push:*) in this repo — repo convention requires explicit per-action user approval before pushing (CLAUDE.md B4)"
    ]
  },
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "high"
    }
  }
}
